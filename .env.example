# VirtualPet 設定範本：在 config\ 內複製一份為 .env（config\.env）後填入。
# 機密只存在這個檔案，不會被編譯進 EXE。

# --- API Key（至少填一組 LLM 與一組 TTS）---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_IMAGES_API_KEY=
AZURE_OPENAI_IMAGES_ENDPOINT=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
VOAI_API_KEY=
AZURE_STT_API_KEY=
AZURE_STT_REGION=

# --- 本機 LLM（Ollama，外部服務，不打包；沒在執行時 VirtualPet.exe 會自動 ollama serve）---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b

# --- ComfyUI（外部服務，不打包）---
# 停用或連不到時自動退回 Mock 服務，App 不會崩潰。
COMFYUI_ENABLED=true
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WS_URL=ws://127.0.0.1:8188
COMFYUI_TIMEOUT_SEC=300
COMFYUI_MAX_RETRIES=2
# Demo PC 的 ComfyUI 安裝根目錄（取代 workflow 內寫死的 C:\ComfyUI_windows_portable_260701）
# COMFYUI_PATH=D:\ComfyUI_windows_portable
# 有填時，ComfyUI 沒在執行就由 VirtualPet.exe 自動啟動（工作目錄 = COMFYUI_PATH）
# COMFYUI_LAUNCH_CMD=run_nvidia_gpu.bat

# --- 本地模型（Release 已內附於 models\，預設離線使用；要覆寫才取消註解）---
# STT_MODEL_PATH=D:\shared_models\whisper
# FASTEMBED_CACHE_PATH=D:\shared_models\fastembed
# HF_HUB_OFFLINE=0

# --- STT ---
STT_ENABLED=true
STT_DEVICE=cuda
STT_LANGUAGE=zh
STT_VAD_ENABLED=true
STT_VAD_SILENCE_MS=750
STT_VAD_THRESHOLD=0.5

# --- Lively 桌布背景（第一次啟動會自動安裝內附的 Lively 並匯入 ECHOES 桌布）---
LIVELY_BACKGROUND_ENABLED=true
