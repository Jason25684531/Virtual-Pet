# VirtualPet settings template: copy to .env (next to VirtualPet.exe) and fill in.
# Secrets live only in this file. They are never compiled into the EXE.

# --- API keys (required: at least one LLM + one TTS) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_IMAGES_API_KEY=
AZURE_OPENAI_IMAGES_ENDPOINT=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
VOAI_API_KEY=
AZURE_STT_API_KEY=
AZURE_STT_REGION=

# --- Local LLM (Ollama, external service) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b-it-qat

# --- ComfyUI (external service, not bundled) ---
# When disabled or unreachable, the app falls back to the mock service and does not crash.
COMFYUI_ENABLED=true
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WS_URL=ws://127.0.0.1:8188
COMFYUI_TIMEOUT_SEC=300
COMFYUI_MAX_RETRIES=2

# --- Model paths (external, not bundled; relative paths resolve against the VirtualPet.exe folder) ---
# Whisper STT model directory (first launch downloads into it automatically)
STT_MODEL_PATH=runtime_cache/whisper
# fastembed embedding/rerank model cache (default is the system TEMP; set it so models move with the app)
FASTEMBED_CACHE_PATH=runtime_cache/fastembed
# Personal memory vector store
QDRANT_PATH=runtime_cache/qdrant

# --- STT ---
STT_ENABLED=true
STT_DEVICE=cuda
STT_LANGUAGE=zh
STT_VAD_ENABLED=true
STT_VAD_SILENCE_MS=750
STT_VAD_THRESHOLD=0.5

LIVELY_BACKGROUND_ENABLED=true
